# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# DeepSeek API (optional, for personalized recommendations)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Database (SQLite by default)
DATABASE_URL=sqlite:///./health_bot.db

# App settings
TIMEZONE=Europe/Moscow
LANGUAGE=ru
LOG_LEVEL=INFO

# Security (change in production!)
ENCRYPTION_PASSWORD=change_me_in_production
TELEGRAM_SALT=change_me_too

# Samsung Health (optional)
SAMSUNG_HEALTH_API_KEY=
SAMSUNG_HEALTH_USER_ID=